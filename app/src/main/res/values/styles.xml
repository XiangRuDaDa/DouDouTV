<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 播放器控制条上的胶囊按钮：遥控器聚焦时点亮品牌色 -->
    <style name="PlayerPill" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/doudou_pill_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- 播放器控制条上的图标按钮（播放/暂停、全屏切换）：与胶囊同底色，方形 -->
    <style name="PlayerIcon" parent="">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/doudou_pill_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">7dp</item>
    </style>
</resources>
